LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_2=
PROMPT_VARIANT=strict
DATA_DIR=data
# Optional official CSV/JSON export URL, or https://udara.jakarta.go.id/ for
# the portal's published station snapshot. Leave blank for the demo snapshot.
SOURCE_DATA_URL=
RETRIEVAL_MODE=hybrid
REWRITE_MODE=rules
MONITORING_DB=monitoring/interactions.jsonl
INTERACTION_RETENTION_DAYS=30
INTERACTION_CLEANUP_INTERVAL_SECONDS=3600
POSTGRES_DSN=
NAPAS_INTERNAL_TOKEN=
TRUST_PROXY_HEADERS=false
CHAT_RATE_LIMIT_MAX=12
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_GLOBAL_RATE_LIMIT_MAX=60
CHAT_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
TELEMETRY_RATE_LIMIT_MAX=120
TELEMETRY_RATE_LIMIT_WINDOW_SECONDS=60
# The Next.js process uses milliseconds for its equivalent windows.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
TELEMETRY_RATE_LIMIT_WINDOW_MS=60000
MAX_CONTEXT_DOCUMENTS=5
QDRANT_URL=http://localhost:6333

# Replacement Next.js/Eve web workspace (`web/`). Keep this key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Abort a provider request after this many milliseconds.
GEMINI_REQUEST_TIMEOUT_MS=120000
NAPAS_API_ORIGIN=http://127.0.0.1:8502
